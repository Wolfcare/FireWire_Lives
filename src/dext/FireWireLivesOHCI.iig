/*
 * FireWireLivesOHCI.iig - DriverKit interface declaration for the OHCI driver.
 *
 * Processed by iig, which emits the C++ glue marshalling calls across the
 * user/kernel boundary. Only the class declaration lives here; the
 * implementation is in FireWireLivesOHCI.cpp.
 *
 * Methods marked LOCALONLY are ordinary C++ member functions - iig generates
 * no RPC for them.
 */

#ifndef FireWireLivesOHCI_h
#define FireWireLivesOHCI_h

#include <DriverKit/IOService.iig>
#include <DriverKit/IOInterruptDispatchSource.iig>
#include <DriverKit/IOBufferMemoryDescriptor.iig>
#include <DriverKit/IODMACommand.iig>
#include <DriverKit/IOMemoryMap.iig>
#include <PCIDriverKit/IOPCIDevice.iig>

class FireWireLivesOHCI: public IOService
{
public:
    virtual bool init(void) override;
    virtual void free(void) override;

    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;

    /*
     * Hardware interrupt callback. OHCI raises this for bus resets, self-ID
     * completion, and async/isochronous DMA context events.
     */
    virtual void InterruptOccurred(OSAction *action,
                                   uint64_t count,
                                   uint64_t time)
        TYPE(IOInterruptDispatchSource::InterruptOccurred);

    /* ---- MMIO helpers over BAR0 ----
     *
     * PCIDriverKit's MemoryRead32/MemoryWrite32 return void and signal a
     * failed read by writing 0xffffffff, so these mirror that shape rather
     * than inventing a kern_return_t that the underlying API cannot provide.
     */
    uint32_t RegisterRead(uint32_t offset) LOCALONLY;
    void     RegisterWrite(uint32_t offset, uint32_t value) LOCALONLY;

    /* ---- Controller bring-up, in the order OHCI 1.1 mandates ---- */
    kern_return_t EnableBusMastering(void) LOCALONLY;
    kern_return_t ResetController(void) LOCALONLY;
    kern_return_t EnableLinkPowerStatus(void) LOCALONLY;
    kern_return_t ConfigureSelfIDBuffer(void) LOCALONLY;
    kern_return_t SetupInterrupts(void) LOCALONLY;
    kern_return_t EnableLink(void) LOCALONLY;

    /* ---- Bus reset handling ---- */
    void HandleBusReset(void) LOCALONLY;
    void HandleSelfIDComplete(void) LOCALONLY;

    /* ---- PHY register access, via the PhyControl register ---- */
    kern_return_t PhyRead(uint8_t address, uint8_t *value) LOCALONLY;
    kern_return_t PhyWrite(uint8_t address, uint8_t value) LOCALONLY;
};

#endif /* FireWireLivesOHCI_h */

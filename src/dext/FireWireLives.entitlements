<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  These are the same three entitlements carried by Apple's own shipping
	  PCIDriverKit driver, com.apple.DriverKit-Apple16X50PCI.dext, which was
	  used as the reference for what a PCI dext needs on macOS 26 / arm64e.

	  For development with SIP disabled and developer mode on, ad-hoc signing
	  with these entitlements is enough. Distribution requires Apple to grant
	  com.apple.developer.driverkit.transport.pci against a Developer ID team,
	  which is a manual request.
	-->
	<key>com.apple.developer.driverkit</key>
	<true/>

	<key>com.apple.developer.driverkit.transport.pci</key>
	<true/>

	<!--
	  Allows our own userspace 1394 stack to open a user client against the
	  driver. Without this, NewUserClient is refused regardless of what the
	  driver itself returns.
	-->
	<key>com.apple.developer.driverkit.userclient-access</key>
	<array>
		<string>com.firewirelives.FireWireLives</string>
	</array>
</dict>
</plist>
